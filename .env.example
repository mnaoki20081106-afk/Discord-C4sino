# ===== Discord =====
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 単一ギルドで運用するなら Guild ID を指定 (guild commands は即反映)。
# 空にするとグローバルコマンド登録 (反映に最大 1 時間)。
DISCORD_GUILD_ID=

# 初回デプロイ以降は 1 を入れておくと、起動時の自動 slash command 再登録を
# スキップする。Discord API 連続叩きで rate limit を食わないため推奨。
# コマンド定義を変更した時だけ一時的に未設定にして再起動すれば反映される。
SKIP_COMMAND_REGISTER=1

# ===== 内部通貨 =====
# 1 JPY = 1 chip
JPY_PER_CHIP=1

# ===== LTC: BlockCypher =====
# ユーザー入金用の固有アドレス発行/監視 (無料枠 200 req/hour)
LTC_API_TOKEN=

# ===== 保存時暗号化 =====
# DB 内の PayPay 認証情報 / LTC 秘密鍵を AES-256-GCM で暗号化するためのマスターキー。
# 32 バイトを hex (64 文字) で指定。例: `openssl rand -hex 32`
# 必須。未設定だと起動時に落ちる。
# 本番で生成後は絶対に変えない (変えると既存の暗号化データが読めなくなる)。
MASTER_ENC_KEY=

# ===== DB =====
DB_PATH=./data/casino.db
